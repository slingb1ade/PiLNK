# PiLNK — files git should never track

# Sensitive / per-node config
.secret_key
config.json
config.json.installer

# Runtime / generated files
update.log
stats_records.json
coverage.json
ota_state.json
audio_build_state.json
datalink_build_state.json
denoise_state.json
.audio_build_task
badge_announced.json
__pycache__/
*.pyc
*.pyo

# Editor / OS noise
.vscode/
.idea/
.DS_Store
*.swp

# Backup files (we should never commit these — they should never exist
# in the repo, but ignoring them prevents future accidents)
*.bak
*.bak.*
*.bak-*

# Dev artifacts / scratch / runtime data (never belong in the repo)
_airspy_syntax_check.sh
# Hub-only dev tools (VDL2 capture/retest, SDR audio extract) - not shipped.
tools/extract-sdr-audio.py
tools/vdl2-capture.py
tools/vdl2-retest.sh
aircraft.csv.gz
aircraft-overlay.csv.gz
recordings/
# Flight capsules — per-node recorded tracks + auto-record rules (v1.5.22).
# Local data: never committed, and never touched by update.sh's reset.
capsules/
# OpenAIP airspace/navaid cache — persisted so a restart doesn't empty it (v1.5.22).
openaip_cache.json
openaip_cache.json.tmp
# History-tab day store — survives restarts (v1.5.23).
history_day.json
history_day.json.tmp
# Aircraft Tracked tiles (Today / Best Day / All Time) — per-node counts.
daily_counts.json
daily_counts.json.tmp
# Remote-maintenance action log — per-node runtime record, never committed.
assist_actions.log
# Tune my radio — "tuning now" marker (STT skips audio) + crash-restore file.
.radio_tuning
.radio_tune_restore.json

# Aircraft photo cache — locally fetched Planespotters images, pruned at
# 200 MB. Per-node runtime data: never the same twice, never worth committing.
cache/
