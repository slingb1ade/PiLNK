[Unit]
Description=PiLNK Wi-Fi setup hotspot (only opens when the Pi has no network)
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/pilnk/pilnk_wifi_setup.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
